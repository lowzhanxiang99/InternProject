@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<style>
    .border-purple {
        border-color: #6f42c1 !important;
    }

    .bg-purple {
        background-color: #6f42c1 !important;
    }

    /* Smooth hover effect for cards */
    .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    /* Fix for long text in chat */
    #chatHistory .bg-white, #chatHistory .bg-primary {
        word-wrap: break-word;
        white-space: pre-line;
    }
</style>

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">Welcome Back, @(ViewBag.UserName ?? "User")!</h4>

        <button class="btn btn-white shadow-sm border rounded-pill px-4 d-flex align-items-center"
                data-bs-toggle="modal" data-bs-target="#aiChatModal"
                style="transition: all 0.3s ease; background-color: white;">
            <i class="bi bi-robot text-primary fs-5 me-2"></i>
            <span class="fw-bold" style="font-size: 0.9rem;">Alpine AI</span>
        </button>
    </div>

    <p class="text-secondary fw-bold mb-3">Leave Balance</p>
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-6 g-3 mb-5">
        @* Annual *@
        <div class="col">
            <div class="card border-0 shadow-sm p-3 text-center h-100">
                <small class="text-muted mb-3 d-block">Annual</small>
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle border border-primary border-4" style="width: 75px; height: 75px;">
                    <span class="fw-bold">@(ViewBag.AnnualLeave ?? "00/00")</span>
                </div>
                <small class="text-muted d-block small">Available - @(ViewBag.AnnualAvailable ?? "0")</small>
                <small class="text-secondary small">Used - @(ViewBag.AnnualUsed ?? "0")</small>
            </div>
        </div>

        @* MC *@
        <div class="col">
            <div class="card border-0 shadow-sm p-3 text-center h-100">
                <small class="text-muted mb-3 d-block">MC</small>
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle border border-info border-4" style="width: 75px; height: 75px;">
                    <span class="fw-bold">@(ViewBag.MCLeave ?? "00/00")</span>
                </div>
                <small class="text-muted d-block small">Available - @(ViewBag.MCAvailable ?? "0")</small>
                <small class="text-secondary small">Used - @(ViewBag.MCUsed ?? "0")</small>
            </div>
        </div>

        @* Compassionate *@
        <div class="col">
            <div class="card border-0 shadow-sm p-3 text-center h-100">
                <small class="text-muted mb-3 d-block">Compassionate</small>
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle border border-success border-4" style="width: 75px; height: 75px;">
                    <span class="fw-bold">@(ViewBag.CompassionateLeave ?? "00/00")</span>
                </div>
                <small class="text-muted d-block small">Available - @(ViewBag.CompassionateAvailable ?? "0")</small>
                <small class="text-secondary small">Used - @(ViewBag.CompassionateUsed ?? "0")</small>
            </div>
        </div>

        @* Maternity *@
        <div class="col">
            <div class="card border-0 shadow-sm p-3 text-center h-100">
                <small class="text-muted mb-3 d-block">Maternity</small>
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle border border-purple border-4" style="width: 75px; height: 75px;">
                    <span class="fw-bold">@(ViewBag.MaternityLeave ?? "00/00")</span>
                </div>
                <small class="text-muted d-block small">Available - @(ViewBag.MaternityAvailable ?? "0")</small>
                <small class="text-secondary small">Used - @(ViewBag.MaternityUsed ?? "0")</small>
            </div>
        </div>

        @* Unpaid *@
        <div class="col">
            <div class="card border-0 shadow-sm p-3 text-center h-100">
                <small class="text-muted mb-3 d-block">Unpaid</small>
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle border border-danger border-4" style="width: 75px; height: 75px;">
                    <span class="fw-bold">@(ViewBag.UnpaidUsed ?? "0")</span>
                </div>
                <small class="text-muted d-block small">-</small>
                <small class="text-secondary small">Used Days</small>
            </div>
        </div>

        @* Other *@
        <div class="col">
            <div class="card border-0 shadow-sm p-3 text-center h-100">
                <small class="text-muted mb-3 d-block">Other</small>
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle border border-warning border-4" style="width: 75px; height: 75px;">
                    <span class="fw-bold">@(ViewBag.OtherLeave ?? "00/00")</span>
                </div>
                <small class="text-muted d-block small">Available - @(ViewBag.OtherAvailable ?? "0")</small>
                <small class="text-secondary small">Used - @(ViewBag.OtherUsed ?? "0")</small>
            </div>
        </div>
    </div>

    @* ATTENDANCE INSIGHTS *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-secondary fw-bold mb-0">Attendance Insights</p>
        <a asp-controller="Home" asp-action="AttendanceHistory" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
            <i class="bi bi-clock-history me-1"></i> View History
        </a>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-4 h-100">
                <small class="text-muted">On Time Percentage</small>
                <div class="d-flex justify-content-between align-items-end mt-2">
                    <div>
                        <h2 class="fw-bold text-primary mb-1">@(ViewBag.OnTimePercentage ?? "0")%</h2>
                        @{
                            var onTimeChange = ViewBag.OnTimeChange ?? 0;
                        }
                        @if (onTimeChange > 0)
                        {
                            <small class="text-success small"><i class="bi bi-graph-up"></i> +@onTimeChange% vs previous month</small>
                        }
                        else if (onTimeChange < 0)
                        {
                            <small class="text-danger small"><i class="bi bi-graph-down"></i> @onTimeChange% vs previous month</small>
                        }
                        else
                        {
                            <small class="text-secondary small"><i class="bi bi-dash"></i> No change</small>
                        }
                    </div>
                    <div class="bg-primary bg-opacity-10 p-2 rounded">
                        <i class="bi bi-bar-chart-fill text-primary"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-4 h-100">
                <small class="text-muted">Late Percentage</small>
                <div class="d-flex justify-content-between align-items-end mt-2">
                    <div>
                        <h2 class="fw-bold text-info mb-1">@(ViewBag.LatePercentage ?? "0")%</h2>
                        @{
                            var lateChange = ViewBag.LateChange ?? 0;
                        }
                        @if (lateChange > 0)
                        {
                            <small class="text-success small"><i class="bi bi-graph-up"></i> +@lateChange% vs previous month</small>
                        }
                        else if (lateChange < 0)
                        {
                            <small class="text-danger small"><i class="bi bi-graph-down"></i> @lateChange% vs previous month</small>
                        }
                        else
                        {
                            <small class="text-secondary small"><i class="bi bi-dash"></i> No change</small>
                        }
                    </div>
                    <div class="bg-info bg-opacity-10 p-2 rounded">
                        <i class="bi bi-clock-history text-info"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-4 h-100">
                <small class="text-muted">Total Break Hours / @DateTime.Now.ToString("MMMM")</small>
                <div class="d-flex justify-content-between align-items-end mt-2">
                    <div>
                        <h5 class="fw-bold mb-1">@(ViewBag.TotalBreakHours ?? "00 Hours 00 Minutes 00 Seconds")</h5>
                        @{
                            var breakChange = ViewBag.BreakChange ?? 0;
                        }
                        @if (breakChange > 0)
                        {
                            <small class="text-success small"><i class="bi bi-graph-up"></i> +@breakChange% vs previous month</small>
                        }
                        else if (breakChange < 0)
                        {
                            <small class="text-danger small"><i class="bi bi-graph-down"></i> @breakChange% vs previous month</small>
                        }
                        else
                        {
                            <small class="text-secondary small"><i class="bi bi-dash"></i> No change</small>
                        }
                    </div>
                    <div class="bg-warning bg-opacity-10 p-2 rounded">
                        <i class="bi bi-cup-hot text-warning"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-4 h-100">
                <small class="text-muted">Total Working Hours / @DateTime.Now.ToString("MMMM")</small>
                <div class="d-flex justify-content-between align-items-end mt-2">
                    <div>
                        <h5 class="fw-bold mb-1">@(ViewBag.TotalWorkingHours ?? "00 Hours 00 Minutes 00 Seconds")</h5>
                        @{
                            var workChange = ViewBag.WorkChange ?? 0;
                        }
                        @if (workChange > 0)
                        {
                            <small class="text-success small"><i class="bi bi-graph-up"></i> +@workChange% vs previous month</small>
                        }
                        else if (workChange < 0)
                        {
                            <small class="text-danger small"><i class="bi bi-graph-down"></i> @workChange% vs previous month</small>
                        }
                        else
                        {
                            <small class="text-secondary small"><i class="bi bi-dash"></i> No change</small>
                        }
                    </div>
                    <div class="bg-success bg-opacity-10 p-2 rounded">
                        <i class="bi bi-briefcase text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* CLAIM SECTION *@
    <p class="text-secondary fw-bold mb-3">Claim Management</p>
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="fw-bold mb-0">My Claims</h5>
                        <small class="text-muted">Status summary for your expense claims</small>
                    </div>
                    <a asp-controller="Claim" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
                        <i class="bi bi-plus-lg me-1"></i> New Claim
                    </a>
                </div>

                <div class="row g-3 text-center">
                    <div class="col-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <h3 class="fw-bold mb-0">@(ViewBag.PendingClaims ?? "0")</h3>
                            <small class="text-warning fw-bold">Pending</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <h3 class="fw-bold mb-0">@(ViewBag.ApprovedClaims ?? "0")</h3>
                            <small class="text-success fw-bold">Approved</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <h3 class="fw-bold mb-0">@(ViewBag.RejectedClaims ?? "0")</h3>
                            <small class="text-danger fw-bold">Rejected</small>
                        </div>
                    </div>
                </div>
                <div class="mt-4">
                    <a asp-controller="Claim" asp-action="Index" class="text-decoration-none small fw-bold">
                        View Claim History <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        @* Quick Link Card *@
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 h-100 bg-primary text-white rounded-4">
                <div class="d-flex flex-column h-100 justify-content-center py-2">
                    <h5 class="fw-bold">Need help with your Claim?</h5>
                    <p class="small opacity-75">Ensure all receipts are clearly photographed and uploaded as JPEG or PDF for faster approval by the Admins team.</p>
                    <div class="mt-auto">
                        <button type="button"
                                class="btn btn-light btn-sm fw-bold px-4 shadow-sm rounded-pill"
                                data-bs-toggle="modal"
                                data-bs-target="#guidelinesModal">
                            <i class="bi bi-book-half me-1"></i> Read Guidelines
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* MODAL GUIDELINES *@
<div class="modal fade" id="guidelinesModal" tabindex="-1" aria-labelledby="guidelinesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title fw-bold" id="guidelinesModalLabel">
                    <i class="bi bi-info-circle me-2"></i>Claim Guidelines
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-dark">
                <div class="d-flex align-items-start mb-3">
                    <i class="bi bi-1-circle-fill text-primary me-3 fs-5"></i>
                    <div>
                        <strong>File Formats:</strong>
                        <p class="text-muted small mb-0">Only JPEG, PNG, or PDF files are accepted.</p>
                    </div>
                </div>
                <div class="d-flex align-items-start mb-3">
                    <i class="bi bi-2-circle-fill text-primary me-3 fs-5"></i>
                    <div>
                        <strong>Photo Quality:</strong>
                        <p class="text-muted small mb-0">Receipts must be clear and readable. Blurry images will be rejected.</p>
                    </div>
                </div>
                <div class="d-flex align-items-start">
                    <i class="bi bi-3-circle-fill text-primary me-3 fs-5"></i>
                    <div>
                        <strong>Timeframe:</strong>
                        <p class="text-muted small mb-0">Please submit claims within 10 days of the expense date.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-primary w-100 fw-bold rounded-pill" data-bs-dismiss="modal">I Understand</button>
            </div>
        </div>
    </div>
</div>

@* AI CHAT MODAL *@
<div class="modal fade" id="aiChatModal" tabindex="-1" aria-labelledby="aiChatModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header border-bottom-0 pt-4 px-4">
                <h5 class="modal-title fw-bold" id="aiChatModalLabel">
                    <i class="bi bi-stars text-primary me-2"></i>Alpine AI Help
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4">
                <div id="chatHistory" class="p-3 mb-3" style="height: 350px; overflow-y: auto; background-color: #f8f9fa; border-radius: 12px; border: 1px solid #eee;">
                    <div class="mb-3">
                        <small class="text-muted fw-bold">AI Assistant</small>
                        <div class="bg-white border p-2 rounded-3 shadow-sm mt-1" style="max-width: 85%;">
                            Hello! I am your Alpine Assistant. How can I help you with your Attendance, Leave, or Claims today?
                        </div>
                    </div>
                </div>
                <div class="input-group mb-3 shadow-sm" style="border-radius: 10px; overflow: hidden;">
                    <input type="text" id="chatInput" class="form-control border-0 py-2 ps-3" placeholder="Type your problem here..." style="background-color: #f1f3f5;">
                    <button class="btn btn-primary px-3" id="btnChatSend">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const $chatHistory = $('#chatHistory');
            const $chatInput = $('#chatInput');
            const $btnSend = $('#btnChatSend');

            // Function to scroll chat to bottom
            function scrollToBottom() {
                $chatHistory.scrollTop($chatHistory[0].scrollHeight);
            }

            $btnSend.click(async function () {
                let msg = $chatInput.val().trim();
                if (!msg) return;

                // 1. Show User Message
                $chatHistory.append(`
                    <div class="text-end mb-3">
                        <small class="text-muted fw-bold">You</small>
                        <div class="bg-primary text-white p-2 rounded-3 shadow-sm mt-1 d-inline-block text-start" style="max-width: 85%;">
                            ${msg}
                        </div>
                    </div>
                `);

                $chatInput.val('');
                scrollToBottom();

                // 2. Add temporary "Thinking" indicator
                const typingId = "typing_" + Date.now();
                $chatHistory.append(`
                    <div class="mb-3" id="${typingId}">
                        <small class="text-muted fw-bold">AI Assistant</small>
                        <div class="bg-white border p-2 rounded-3 shadow-sm mt-1" style="max-width: 85%;">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span class="ms-2 text-muted small">Thinking...</span>
                        </div>
                    </div>
                `);
                scrollToBottom();

                try {
                    const response = await fetch('/Home/AskGemini', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: msg })
                    });

                    const data = await response.json();

                    // Remove the typing indicator
                    $(`#${typingId}`).remove();

                    // Logic to extract the text regardless of how your controller returns it
                    let reply = "";
                    if (data.reply) {
                        reply = data.reply;
                    } else if (data.candidates && data.candidates[0].content.parts[0].text) {
                        reply = data.candidates[0].content.parts[0].text;
                    } else {
                        reply = "I received the data, but couldn't parse the text. Check the console.";
                        console.log("Unexpected data structure:", data);
                    }

                    // 3. Show AI Reply
                    $chatHistory.append(`
                        <div class="mb-3">
                            <small class="text-muted fw-bold">AI Assistant</small>
                            <div class="bg-white border p-2 rounded-3 shadow-sm mt-1" style="max-width: 85%;">
                                ${reply}
                            </div>
                        </div>
                    `);
                    scrollToBottom();

                } catch (err) {
                    $(`#${typingId}`).remove();
                    console.error("AI Error:", err);
                    $chatHistory.append(`<div class="text-danger small mb-3">Error connecting to AI. Please try again later.</div>`);
                    scrollToBottom();
                }
            });

            $chatInput.keypress(function (e) {
                if (e.which == 13) {
                    e.preventDefault(); // Prevents page reload or accidental form submission
                    $btnSend.click();
                }
            });
        });
    </script>
}