@model IEnumerable<InternProject1.Models.StaffSummaryViewModel>

@{
    var selectedMonthLabel = Context.Request.Query["month"].ToString();
    if (string.IsNullOrEmpty(selectedMonthLabel)) { selectedMonthLabel = DateTime.Now.ToString("MMMM yyyy"); }

    var totalAttendance = Model?.Sum(s => s.AttendanceCount) ?? 0;
    var totalLate = Model?.Sum(s => s.LateCount) ?? 0;
    var totalLeave = Model?.Sum(s => s.LeaveCount) ?? 0;
    var totalAbsent = Model?.Sum(s => s.AbsentCount) ?? 0;

    // New Data Points
    var totalHolidays = Model?.FirstOrDefault()?.HolidayCount ?? 0;
    var totalSundays = Model?.FirstOrDefault()?.SundayCount ?? 0;

    bool hasData = Model != null && Model.Any();

    // --- NEW LOGIC: Filter employees who have leave counts > 0 ---
    var leaveDetails = Model?.Where(s => s.LeaveCount > 0).ToList() ?? new List<InternProject1.Models.StaffSummaryViewModel>();
}

<div class="container-fluid p-0" style="background-color: #f4f7f6; min-height: 100vh;">
    @* Header Section *@
    <div class="text-center py-3 mb-3 shadow-sm" style="background: linear-gradient(135deg, #BDD2E7 0%, #9bbad9 100%);">
        <h5 class="fw-bold m-0 text-dark">ATTENDANCE ANALYTICS</h5>

        <div class="d-flex align-items-center justify-content-center gap-2 mt-2">
            <div class="dropdown">
                <button class="btn btn-white btn-sm dropdown-toggle shadow-sm px-3 py-1 border-0"
                        type="button" id="dateDropdown" data-bs-toggle="dropdown" aria-expanded="false"
                        style="border-radius: 20px; font-size: 0.75rem; background-color: white;">
                    <i class="bi bi-calendar3 me-1"></i> <span id="currentSelection">@selectedMonthLabel</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-center shadow border-0" aria-labelledby="dateDropdown" style="font-size: 0.8rem; border-radius: 12px;">
                    @if (ViewBag.MonthsList != null)
                    {
                        foreach (var m in ViewBag.MonthsList)
                        {
                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="filterByMonth('@m')">@m</a></li>
                        }
                    }
                </ul>
            </div>

            <a asp-action="YearlyReport" asp-route-year="2026" class="btn btn-primary btn-sm shadow-sm px-3 py-1 border-0"
               style="border-radius: 20px; font-size: 0.75rem; background-color: #4A77A5;">
                <i class="bi bi-graph-up me-1"></i> Yearly Report
            </a>
        </div>
    </div>

    <div class="container">
        @* Summary Cards *@
        <div class="row g-2 mb-4 justify-content-center">
            @{
                // --- UPDATED: Added ModalTarget to distinguish which modal to open ---
                var cardItems = new[] {
                        new { Title = "Attendance", Count = totalAttendance.ToString(), Color = "#4A77A5", Desc = "Present", Clickable = false, ModalTarget = "" },
                        new { Title = "Late", Count = totalLate.ToString(), Color = "#FFCC00", Desc = "Late In", Clickable = false, ModalTarget = "" },
                        new { Title = "Leave", Count = totalLeave.ToString(), Color = "#99CCFF", Desc = "On Leave", Clickable = true, ModalTarget = "#leaveDetailsModal" },
                        new { Title = "Absent", Count = totalAbsent.ToString(), Color = "#FF6666", Desc = "Absent", Clickable = false, ModalTarget = "" },
                        new { Title = "Holidays", Count = totalHolidays.ToString(), Color = "#6c757d", Desc = "Public", Clickable = true, ModalTarget = "#malaysiaHolidayModal" },
                        new { Title = "Sundays", Count = totalSundays.ToString(), Color = "#adb5bd", Desc = "Weekend", Clickable = false, ModalTarget = "" }
                        };
            }

            @foreach (var item in cardItems)
            {
                <div class="col-4 col-md-2">
                    <div class="p-2 border-0 text-center shadow-sm h-100 @(item.Clickable ? "holiday-card-trigger" : "")"
                         style="background-color: white; border-radius: 12px; border-bottom: 4px solid @item.Color !important; cursor: @(item.Clickable ? "pointer" : "default"); transition: all 0.2s;"
                         @(item.Clickable ? $"data-bs-toggle=modal data-bs-target={item.ModalTarget}" : "")>
                        <p class="text-uppercase mb-1 text-muted" style="font-size: 0.6rem; font-weight: 700;">@item.Title</p>
                        <h4 class="fw-bold m-0" style="color: #333;">@item.Count</h4>
                        <div class="d-flex align-items-center justify-content-center mt-1 fw-semibold" style="color: @item.Color; font-size: 0.65rem;">
                            @if (item.Clickable)
                            {
                                <i class="bi bi-search me-1"></i>
                            }
                            @item.Desc
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Chart Section *@
        <div class="card border-0 shadow-sm mb-4 p-3" style="border-radius: 15px; background: white;">
            <p class="fw-bold text-muted mb-2 small" style="font-size: 0.8rem;"><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Workday Distribution</p>
            <div style="height: 280px; width: 100%; position: relative;">
                @if (!hasData)
                {
                    <div class="position-absolute top-50 start-50 translate-middle text-center w-100" style="z-index: 10;">
                        <i class="bi bi-clipboard2-x text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
                        <p class="text-muted fw-bold mt-2">No records found for @selectedMonthLabel</p>
                    </div>
                }
                <canvas id="attendanceBarChart" style="@(hasData ? "" : "opacity: 0.1;")"></canvas>
            </div>
        </div>

        @* Employee Search *@
        <div class="row justify-content-center mb-4">
            <div class="col-lg-9">
                <div class="card border-0 shadow-sm p-4 text-center" style="border-radius: 20px; background: white;">
                    <div class="mb-3">
                        <h6 class="fw-bold m-0">Employee Detailed Log</h6>
                        <p class="text-muted" style="font-size: 0.75rem;">Search and select to view individual history</p>
                    </div>

                    <div class="row g-2 justify-content-center align-items-center">
                        <div class="col-md-8 text-start">
                            <select id="employeeSelect" class="form-select border-2 py-2" style="border-radius: 10px;">
                                <option value="">Start typing name...</option>
                                @if (ViewBag.EmployeeList != null)
                                {
                                    foreach (var emp in ViewBag.EmployeeList)
                                    {
                                        <option value="@emp.Employee_ID">@emp.FullName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary w-100 fw-bold py-2" onclick="goToDetails()" style="border-radius: 10px; background: #4A77A5; border: none;">
                                VIEW REPORT
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Export Buttons *@
        <div class="d-flex justify-content-center gap-2 pb-5">
            <a asp-action="ExportToExcel" asp-route-month="@selectedMonthLabel" class="btn btn-outline-secondary btn-sm px-3" style="border-radius: 8px; font-size: 0.75rem;">
                <i class="bi bi-file-earmark-excel me-1"></i>Excel
            </a>
            <a asp-action="ExportToPdf" asp-route-month="@selectedMonthLabel" class="btn btn-outline-secondary btn-sm px-3" style="border-radius: 8px; font-size: 0.75rem;">
                <i class="bi bi-file-earmark-pdf me-1"></i>PDF
            </a>
        </div>
    </div>
</div>

@* --- UPDATED MODAL: STAFF ON LEAVE WITH SPECIFIC DATES --- *@
<div class="modal fade" id="leaveDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 15px;">
            <div class="modal-header border-0 bg-info text-white" style="border-radius: 15px 15px 0 0; background-color: #99CCFF !important;">
                <h6 class="modal-title fw-bold text-dark"><i class="bi bi-person-walking me-2"></i>Staff on Leave - @selectedMonthLabel</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive" style="max-height: 400px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light sticky-top">
                            <tr class="text-muted small">
                                <th class="ps-4">Employee Name</th>
                                <th class="text-center">Days Taken</th>
                                <th>Specific Dates</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (leaveDetails.Any())
                            {
                                foreach (var staff in leaveDetails)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">@staff.Name</td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-primary border">@staff.LeaveCount Days</span>
                                        </td>
                                        <td>
                                            @if (staff.LeaveDatesList != null && staff.LeaveDatesList.Any())
                                            {
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var date in staff.LeaveDatesList)
                                                    {
                                                        <span class="badge rounded-pill border text-dark fw-normal" style="font-size: 0.7rem; background-color: #f8f9fa;">@date</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <small class="text-muted italic">No dates provided</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">No leave records found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light py-2">
                <button type="button" class="btn btn-sm btn-secondary px-4" data-bs-dismiss="modal" style="border-radius: 8px;">Close</button>
            </div>
        </div>
    </div>
</div>

@* --- UPDATED MODAL: MALAYSIA HOLIDAYS 2026 --- *@
<div class="modal fade" id="malaysiaHolidayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 15px;">
            <div class="modal-header border-0 bg-dark text-white" style="border-radius: 15px 15px 0 0;">
                <h6 class="modal-title fw-bold"><i class="bi bi-calendar-check me-2"></i>Official Malaysia Holidays 2026</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive" style="max-height: 500px;">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                        <thead class="bg-light sticky-top">
                            <tr class="text-muted small">
                                <th class="ps-4">Date</th>
                                <th>Holiday Name</th>
                                <th>Type</th>
                                <th class="text-center">Observed</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td class="ps-4 fw-bold">1 Jan (Thu)</td><td>New Year's Day</td><td>Federal</td><td class="text-center">-</td></tr>
                            <tr class="table-info"> <td class="ps-4 fw-bold">1 Feb (Sun)</td><td>Thaipusam / FT Day</td><td>State</td><td class="text-center">Yes</td></tr>
                            <tr class="table-light"> <td class="ps-4 fw-bold">2 Feb (Mon)</td><td>Thaipusam Holiday</td><td>State</td><td class="text-center">Yes</td></tr>
                            <tr class="table-light"> <td class="ps-4 fw-bold">3 Feb (Tue)</td><td>FT Day Holiday</td><td>State</td><td class="text-center">Yes</td></tr>
                            <tr><td class="ps-4 fw-bold">17 Feb (Tue)</td><td>Chinese New Year</td><td>Federal</td><td class="text-center">-</td></tr>
                            <tr><td class="ps-4 fw-bold">18 Feb (Wed)</td><td>Chinese New Year (Day 2)</td><td>Federal</td><td class="text-center">-</td></tr>
                            <tr><td class="ps-4 fw-bold">7 Mar (Sat)</td><td>Nuzul Al-Quran</td><td>Federal</td><td class="text-center">-</td></tr>
                            <tr><td class="ps-4 fw-bold">21 Mar (Sat)</td><td>Hari Raya Aidilfitri</td><td>Federal</td><td class="text-center">-</td></tr>
                            <tr class="table-info"> <td class="ps-4 fw-bold">22 Mar (Sun)</td><td>Hari Raya Aidilfitri (Day 2)</td><td>Federal</td><td class="text-center">Yes</td></tr>
                            <tr class="table-light"> <td class="ps-4 fw-bold">23 Mar (Mon)</td><td>Hari Raya Aidilfitri Holiday</td><td>Federal</td><td class="text-center">Yes</td></tr>
                            <tr><td class="ps-4 fw-bold">1 May (Fri)</td><td>Labour Day</td><td>Federal</td><td class="text-center">-</td></tr>
                            <tr><td class="ps-4 fw-bold">27 May (Wed)</td><td>Hari Raya Haji</td><td>Federal</td><td class="text-center">-</td></tr>
                            <tr class="table-info"> <td class="ps-4 fw-bold">31 May (Sun)</td><td>Wesak Day</td><td>Federal</td><td class="text-center">Yes</td></tr>
                            <tr class="table-light"> <td class="ps-4 fw-bold">1 Jun (Mon)</td><td>Wesak Day / Agong's Bday</td><td>Federal</td><td class="text-center">Yes</td></tr>
                            <tr><td class="ps-4 fw-bold">17 Jun (Wed)</td><td>Awal Muharram</td><td>Federal</td><td class="text-center">-</td></tr>
                            <tr><td class="ps-4 fw-bold">25 Aug (Tue)</td><td>Prophet Muhammad's Bday</td><td>Federal</td><td class="text-center">-</td></tr>
                            <tr><td class="ps-4 fw-bold">31 Aug (Mon)</td><td>Merdeka Day</td><td>Federal</td><td class="text-center">-</td></tr>
                            <tr><td class="ps-4 fw-bold">16 Sep (Wed)</td><td>Malaysia Day</td><td>Federal</td><td class="text-center">-</td></tr>
                            <tr class="table-info"> <td class="ps-4 fw-bold">8 Nov (Sun)</td><td>Deepavali</td><td>Federal</td><td class="text-center">Yes</td></tr>
                            <tr class="table-light"> <td class="ps-4 fw-bold">9 Nov (Mon)</td><td>Deepavali Holiday</td><td>Federal</td><td class="text-center">Yes</td></tr>
                            <tr><td class="ps-4 fw-bold">25 Dec (Fri)</td><td>Christmas Day</td><td>Federal</td><td class="text-center">-</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light py-2">
                <small class="text-muted me-auto ps-2">* Includes Replacement Holidays for Sundays</small>
                <button type="button" class="btn btn-sm btn-outline-dark px-4" data-bs-dismiss="modal" style="border-radius: 8px;">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    .holiday-card-trigger:hover {
        background-color: #f0f0f0 !important;
        transform: scale(1.03);
    }
</style>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(document).ready(function() {
            $('#employeeSelect').select2({
                placeholder: "Search for an employee...",
                allowClear: true,
                width: '100%'
            });

            const canvas = document.getElementById('attendanceBarChart');
            if (canvas) {
                const ctx = canvas.getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Attendance', 'Late', 'Leave', 'Absent', 'Holidays', 'Sundays'],
                        datasets: [{
                            label: 'Days',
                            data: [@totalAttendance, @totalLate, @totalLeave, @totalAbsent, @totalHolidays, @totalSundays],
                            backgroundColor: ['#4A77A5', '#FFCC00', '#99CCFF', '#FF6666', '#6c757d', '#adb5bd'],
                            borderRadius: 6,
                            barThickness: 35
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: '#f0f0f0' },
                                ticks: {
                                    stepSize: 1,
                                    font: { size: 10 }
                                }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { font: { size: 10 } }
                            }
                        }
                    }
                });
            }
        });

        function filterByMonth(monthYear) {
            window.location.href = window.location.pathname + '?month=' + encodeURIComponent(monthYear);
        }

        function goToDetails() {
            var id = $('#employeeSelect').val();
            var month = '@selectedMonthLabel';
            if (id) {
                window.location.href = '/AttendanceReport/EmployeeDetails/' + id + '?month=' + encodeURIComponent(month);
            } else {
                alert("Please select an employee name first.");
            }
        }
    </script>
}